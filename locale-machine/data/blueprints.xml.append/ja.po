msgstr "サーチャー"

#: src-en/data/blueprints.xml.append:2988
msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_EG_SEARCHER\"]/name"
msgstr "遠い信号"

