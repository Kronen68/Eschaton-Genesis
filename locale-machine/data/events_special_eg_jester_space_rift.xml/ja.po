msgstr "狂信者たちが祈りを捧げ終える……"

#: src-en/data/events_special_eg_jester_space_rift.xml:562
msgid ""
"data/events_special_eg_jester_space_rift.xml$//event[@name=\"DREAMSEEKER_PRAYER_ENEMY\"]/choice/text"
