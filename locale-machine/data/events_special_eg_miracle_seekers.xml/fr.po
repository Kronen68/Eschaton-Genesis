" and @lvl=\"1\"]/event/choice/text"
msgstr "Courez jusqu'à votre vaisseau !"

#: src-en/data/events_special_eg_miracle_seekers.xml:2835
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_QUEST_HORN_OF_GOD_EXPLORING_3\"]/choice[@req=\"termite_doors_unlocked\""
" and @lvl=\"0\"]/text"
msgstr "Le sas de la salle du réacteur est fermé."

#: src-en/data/events_special_eg_miracle_seekers.xml:2841
msgid ""
