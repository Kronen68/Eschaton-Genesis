msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_QUEST_TERMITES_EATERY\"]/choice/event/choice[5]/text"
msgstr "Hmm... Cependant, nous ne voulons pas nous impliquer là-dedans."

#: src-en/data/events_special_eg_miracle_seekers.xml:3237
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_QUEST_TERMITES_EATERY\"]/choice/event/choice[5]/event/text"
msgstr ""
"Vous fuyez le restaurant et les termites sans aucune explication. Les "
"termites et les employés du restaurant vous regardent avec une stupidité "
"égale."

#: src-en/data/events_special_eg_miracle_seekers.xml:3239
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_QUEST_TERMITES_EATERY\"]/choice/event/choice[5]/event/choice/text"
