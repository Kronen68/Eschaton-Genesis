msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"MIRACLE_SEEKERS_SHOP\"]/choice[@req=\"seekers_shop_visited\""
" and @lvl=\"0\"]/event/choice/event/choice[@req=\"eg_corporate_debt\"]/text"
msgstr "Rembourser la dette."

#: src-en/data/events_special_eg_miracle_seekers.xml:1033
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"MIRACLE_SEEKERS_SHOP\"]/choice[@req=\"seekers_shop_visited\""
" and "
"@lvl=\"0\"]/event/choice/event/choice[@req=\"eg_corporate_debt\"]/event/text"
msgstr ""
"Manager accepte joyeusement votre ferraille. \"Génial ! Je ne pensais pas que vous me la rendriez vraiment...\"\n"
"\n"
"Malheureusement, il ne peut rien vous vendre maintenant, se référant à nouveau à la \"limace dans un étrange costume.\""

#: src-en/data/events_special_eg_miracle_seekers.xml:1043
