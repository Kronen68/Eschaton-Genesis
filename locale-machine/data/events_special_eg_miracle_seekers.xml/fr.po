msgstr "(Drone Médical) Le réanimer immédiatement."

#: src-en/data/events_special_eg_miracle_seekers.xml:2763
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_QUEST_HORN_OF_GOD_EXPLORING_3\"]/choice[1]/event/choice[@req=\"BLUELIST_DRONES_MEDICAL\"]/event/text"
