#: src-en/data/events_special_eg_miracle_seekers.xml:97
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_MIRACLE_SEEKERS_STATION\"]/choice[@req=\"miracle_seekers_metarep\""
" and @lvl=\"1\"]/event/choice[2]/text"
msgstr ""
"Cependant, peut-être pourriez-vous expliquer une fois de plus qui vous êtes "
