"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_QUEST_THANKS_2\"]/choice/event/choice[2]/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/text"
msgstr "Envoyez cette Limace en enfer et envolez-vous."

#: src-en/data/events_special_eg_miracle_seekers.xml:3848
msgid ""
