#: src-en/data/events_special_eg_miracle_seekers.xml:4389
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"WHITE_THREAD_TRUE_RESOLUTION_CREW\"]/text"
msgstr ""
"\"Bien. Mon peuple et moi serons heureux de travailler sur votre vaisseau.\""
" Le vaisseau de l'Empereur s'amarre au vôtre, et l'un des membres de la "
"Garde Blanche est le premier à passer par le sas entre les vaisseaux."

#: src-en/data/events_special_eg_miracle_seekers.xml:4392
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"WHITE_THREAD_TRUE_RESOLUTION_CREW\"]/choice/text"
