msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"DESTROYED_EG_ENEMY_MIRACLE_SEEKERS\"]/text"
msgstr "Vous n'étiez pas censé voir ça. Au moins, pas encore."

#: src-en/data/events_special_eg_miracle_seekers.xml:4496
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"DESTROYED_EG_ENEMY_MIRACLE_SEEKERS\"]/choice/text"
