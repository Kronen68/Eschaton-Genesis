#: src-en/data/events_special_eg_miracle_seekers.xml:4394
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"WHITE_THREAD_TRUE_RESOLUTION_CREW\"]/choice/event/text"
msgstr "Le deuxième membre de la Garde Blanche suit immédiatement le premier."

#: src-en/data/events_special_eg_miracle_seekers.xml:4397
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"WHITE_THREAD_TRUE_RESOLUTION_CREW\"]/choice/event/choice/text"
