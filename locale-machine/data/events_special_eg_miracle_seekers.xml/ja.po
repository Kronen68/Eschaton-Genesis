#: src-en/data/events_special_eg_miracle_seekers.xml:1287
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"MIRACLE_SEEKERS_SPACE_RIFT\"]/choice[@req=\"seekers_quest_started\""
" and "
