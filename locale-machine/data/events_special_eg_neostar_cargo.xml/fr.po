msgid ""
"data/events_special_eg_neostar_cargo.xml$//event[@name=\"EG_NEOSTAR_LOYALTY_PROGRAM_FINAL\"]/choice/event/choice/event/text"
msgstr ""
"\"Félicitations, Employé Junior de Neostar ! Vous avez obtenu votre première"
" promotion et êtes maintenant un employé Neostar à part entière. Cela "
"signifie que vous aurez l'opportunité de choisir quelles livraisons de "
"cargaison vous souhaitez traiter, vous aurez l'opportunité de gagner un "
"salaire plus élevé, et, plus important encore, à partir de maintenant, vous "
"recevrez officiellement un logement dans les limites de notre entreprise !\""

#: src-en/data/events_special_eg_neostar_cargo.xml:277
msgid ""
