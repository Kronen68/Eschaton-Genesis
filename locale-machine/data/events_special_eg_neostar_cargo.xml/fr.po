msgstr "Qu'est-ce qui m'attend après ma promotion ?"

#: src-en/data/events_special_eg_neostar_cargo.xml:341
msgid ""
"data/events_special_eg_neostar_cargo.xml$//event[@name=\"EG_NEOSTAR_TUTORIAL_MENU\"]/choice[3]/event/text"
msgstr ""
